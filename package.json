{
  "name": "epocanvas-docs",
  "version": "1.3.2-beta.1",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.12.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/invalidate-render-cache.mjs",
    "build": "astro build",
    "verify": "pnpm run verify:config && pnpm run prebuild && pnpm exec astro check && pnpm run build && pnpm run verify:static",
    "verify:config": "node scripts/verify-release.mjs --config",
    "verify:static": "node --test scripts/*.test.mjs && node scripts/audit-i18n.mjs && node scripts/check-anchors.mjs && node scripts/check-images.mjs && node scripts/check-localized-images.mjs && node scripts/check-links.mjs",
    "verify:release": "node scripts/verify-release.mjs --tag",
    "verify:deploy": "node scripts/verify-release.mjs --deploy-check",
    "deploy": "node scripts/verify-release.mjs --deploy",
    "verify:preview": "node scripts/pages-preview.mjs --check",
    "deploy:preview": "node scripts/pages-preview.mjs --deploy",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.41.11",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@pagefind/default-ui": "1.6.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.1"
  }
}
