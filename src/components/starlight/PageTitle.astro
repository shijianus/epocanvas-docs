---
export const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const title = entry.data.title;
---

<div class="page-title-wrapper">
	<h1 id={PAGE_TITLE_ID} class="page-title-heading">{title}</h1>
</div>

<style>
	.page-title-wrapper {
		margin-top: 0.5rem;
		margin-bottom: 2rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline, #e2e8f0);
	}

	.page-title-heading {
		font-size: var(--sl-text-h1, 2.25rem);
		line-height: var(--sl-line-height-headings, 1.25);
		font-weight: 700;
		color: var(--sl-color-white);
		letter-spacing: -0.025em;
		margin: 0;
	}
</style>
