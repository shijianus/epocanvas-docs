---
/**
 * 上一页 / 下一页 分页导航（覆盖 Starlight 内置 Pagination 组件）。
 * 参考 doc.skymail.ink 的扁平分页样式：细边框、无阴影、主题色标题，
 * 并在卡片内使用 ↙ / ↘ 斜向箭头指示翻页方向。
 */
const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';

// 斜向箭头：上一页朝左下（↙），下一页朝右下（↘）；RTL 阅读方向时镜像。
const prevArrow = isRtl ? 'M7 7l10 10M17 8.5V17H8.5' : 'M17 7 7 17M7 8.5V17h8.5';
const nextArrow = isRtl ? 'M17 7 7 17M7 8.5V17h8.5' : 'M7 7l10 10M17 8.5V17H8.5';
---

<div class="pagination-links print:hidden" dir={dir}>
	{
		prev && (
			<a href={prev.href} rel="prev">
				<svg aria-hidden="true" class="pager-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d={prevArrow} />
				</svg>
				<span class="pager-text">
					<span class="pager-label">{Astro.locals.t('page.previousLink')}</span>
					<span class="pager-title">{prev.label}</span>
				</span>
			</a>
		)
	}
	{
		next && (
			<a href={next.href} rel="next">
				<span class="pager-text">
					<span class="pager-label">{Astro.locals.t('page.nextLink')}</span>
					<span class="pager-title">{next.label}</span>
				</span>
				<svg aria-hidden="true" class="pager-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d={nextArrow} />
				</svg>
			</a>
		)
	}
</div>

<style>
	.pagination-links {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
		gap: 1rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		box-sizing: border-box;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 8px;
		padding: 0.8rem 1rem;
		background-color: transparent;
		box-shadow: none;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
		transition: border-color 0.18s cubic-bezier(0.4, 0, 0.2, 1);
	}

	a[rel='next'] {
		justify-content: flex-end;
		text-align: end;
	}

	a:hover {
		border-color: var(--sl-color-accent);
	}

	a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.pager-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.pager-label {
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--sl-color-gray-3);
	}

	.pager-title {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.45;
		color: var(--sl-color-accent);
	}

	.pager-arrow {
		flex-shrink: 0;
		color: var(--sl-color-gray-4);
		transition: color 0.18s cubic-bezier(0.4, 0, 0.2, 1), transform 0.18s cubic-bezier(0.4, 0, 0.2, 1);
	}

	a:hover .pager-arrow {
		color: var(--sl-color-accent);
	}

	a[rel='prev']:hover .pager-arrow {
		transform: translate(-2px, 2px);
	}

	a[rel='next']:hover .pager-arrow {
		transform: translate(2px, 2px);
	}
</style>
