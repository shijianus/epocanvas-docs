---
import '@pagefind/default-ui/css/ui.css';
import project from 'virtual:starlight/project-context';
import { getLangFromLocale, getTranslation, UI_TRANSLATIONS } from '../../utils/i18n';

const lang = getLangFromLocale(Astro.currentLocale);
const t = (key: string) => getTranslation(key, lang);

// Pagefind 弹窗文案：键名去掉 pagefind. 前缀后直接喂给 PagefindUI 的 translations
const pagefindTranslations = {
	placeholder: t('search.placeholder'),
	...Object.fromEntries(
		Object.entries(UI_TRANSLATIONS[lang] ?? {})
			.filter(([key]) => key.startsWith('pagefind.'))
			.map(([key, value]) => [key.replace('pagefind.', ''), value])
	),
};

const dataAttributes: DOMStringMap = {
	'data-translations': JSON.stringify(pagefindTranslations),
	'data-zero-results': t('search.zeroResults'),
};
if (project.trailingSlash === 'never') dataAttributes['data-strip-trailing-slash'] = '';
---

<site-search class="epo-site-search" {...dataAttributes}>
	<!-- Header In-Page Direct Search Box with Centered Layout & Complete Text Display -->
	<div class="epo-search-box" id="epo-search-box" role="search">
		<span class="search-box-icon">
			<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			</svg>
		</span>

		<!-- In-Page Direct Interactive Input -->
		<input
			id="epo-inpage-input"
			class="epo-search-input"
			type="text"
			autocomplete="off"
			spellcheck="false"
			placeholder={t('search.placeholder')}
			aria-label={t('search.label')}
		/>

		<!-- In-Page Match Navigation Controls (Shown when active query matches) -->
		<div id="epo-search-nav" class="epo-search-nav" style="display: none;">
			<span id="epo-search-count" class="epo-search-count">0/0</span>
			<button type="button" id="epo-search-prev" class="inpage-nav-btn" title={t('search.prevTitle')}>
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
			</button>
			<button type="button" id="epo-search-next" class="inpage-nav-btn" title={t('search.nextTitle')}>
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
			</button>
			<button type="button" id="epo-search-clear" class="inpage-clear-btn" title={t('search.clearTitle')}>
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
			</button>
		</div>

		<!-- Global Search Modal Trigger Shortcut Badge (Ctrl+K) -->
		<button
			type="button"
			id="epo-modal-trigger"
			data-open-modal
			class="search-shortcut-badge"
			title={t('search.shortcutTitle')}
			aria-label={t('search.openModalAria')}
			aria-keyshortcuts="Control+K"
		>
			<kbd class="key-mod">Ctrl</kbd>
			<kbd class="key-char">K</kbd>
		</button>
	</div>

	<!-- Full-featured Pagefind Global Search Modal Dialog (Triggered by Ctrl+K or Shortcut Badge) -->
	<dialog class="epo-search-dialog" aria-label={t('search.label')} style="padding:0">
		<div class="epo-search-modal-frame">
			<div class="modal-header">
				<div class="modal-title-row">
					<div class="modal-badge">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<span>{t('search.modalTitle')}</span>
					</div>
					<button data-close-modal class="modal-close-btn" type="button" aria-label={t('search.cancelLabel')}>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>

			<div class="modal-body">
				<div class="search-container">
					<div id="starlight__search"></div>
				</div>
			</div>

			<div class="modal-footer">
				<div class="footer-shortcuts">
					<span class="shortcut-item">
						<kbd>↑</kbd><kbd>↓</kbd>
						<span class="shortcut-text">{t('search.hint.navigate')}</span>
					</span>
					<span class="shortcut-item">
						<kbd>↵</kbd>
						<span class="shortcut-text">{t('search.hint.select')}</span>
					</span>
					<span class="shortcut-item">
						<kbd>ESC</kbd>
						<span class="shortcut-text">{t('search.hint.close')}</span>
					</span>
				</div>
				<div class="footer-brand">
					<span>{t('search.modalTitle')}</span>
				</div>
			</div>
		</div>
	</dialog>
</site-search>

<script is:inline>
	(() => {
		const modKeys = document.querySelectorAll('.key-mod');
		if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.userAgent)) {
			modKeys.forEach((key) => {
				key.textContent = '⌘';
			});
			const trigger = document.getElementById('epo-modal-trigger');
			if (trigger) {
				trigger.setAttribute('aria-keyshortcuts', 'Meta+K');
				// 文案键里的快捷键写死为 Ctrl+K，苹果平台上提示同步换成 ⌘，避免两处不一致
				if (trigger.title) trigger.title = trigger.title.replace(/Ctrl/i, '⌘');
			}
		}
	})();
</script>

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

	class SiteSearch extends HTMLElement {
		constructor() {
			super();
			const searchBox = this.querySelector<HTMLElement>('#epo-search-box')!;
			const inpageInput = this.querySelector<HTMLInputElement>('#epo-inpage-input')!;
			const searchNav = this.querySelector<HTMLElement>('#epo-search-nav')!;
			const searchCount = this.querySelector<HTMLElement>('#epo-search-count')!;
			const prevBtn = this.querySelector<HTMLButtonElement>('#epo-search-prev')!;
			const nextBtn = this.querySelector<HTMLButtonElement>('#epo-search-next')!;
			const clearBtn = this.querySelector<HTMLButtonElement>('#epo-search-clear')!;

			const modalTrigger = this.querySelector<HTMLButtonElement>('#epo-modal-trigger')!;
			const closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]')!;
			const dialog = this.querySelector<HTMLDialogElement>('dialog')!;
			const modalFrame = this.querySelector('.epo-search-modal-frame')!;

			let matches: HTMLElement[] = [];
			let currentIndex = -1;
			let debounceTimer: any = null;

			// --- In-Page Highlighting & Jump Engine (EpoCanvas High-Contrast Pattern) ---
			const clearHighlights = () => {
				const marks = document.querySelectorAll('mark.epo-doc-highlight');
				marks.forEach((mark) => {
					const parent = mark.parentNode;
					if (parent) {
						parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
						parent.normalize();
					}
				});
				matches = [];
				currentIndex = -1;
				if (searchNav) searchNav.style.display = 'none';
			};

			const updateActiveMatch = (newIndex: number) => {
				if (!matches.length) {
					currentIndex = -1;
					if (searchCount) searchCount.textContent = this.dataset.zeroResults || '0';
					if (searchNav) searchNav.style.display = 'flex';
					return;
				}

				if (currentIndex >= 0 && currentIndex < matches.length) {
					matches[currentIndex]?.classList.remove('active');
				}

				currentIndex = ((newIndex % matches.length) + matches.length) % matches.length;
				const currentMark = matches[currentIndex];
				if (currentMark) {
					currentMark.classList.add('active');
					currentMark.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}

				if (searchCount) {
					searchCount.textContent = `${currentIndex + 1}/${matches.length}`;
				}
				if (searchNav) searchNav.style.display = 'flex';
			};

			const performInpageSearch = (query: string) => {
				clearHighlights();
				const clean = query.trim();
				if (!clean) return;

				const container =
					document.querySelector('.sl-markdown-content') ||
					document.querySelector('main') ||
					document.body;
				if (!container) return;

				const walker = document.createTreeWalker(
					container,
					NodeFilter.SHOW_TEXT,
					{
						acceptNode(node) {
							if (!node.nodeValue || !node.nodeValue.trim()) {
								return NodeFilter.FILTER_REJECT;
							}
							const parent = node.parentElement;
							if (!parent) return NodeFilter.FILTER_REJECT;
							const tag = parent.tagName.toLowerCase();
							if (
								tag === 'script' ||
								tag === 'style' ||
								tag === 'textarea' ||
								tag === 'input' ||
								tag === 'mark'
							) {
								return NodeFilter.FILTER_REJECT;
							}
							if (
								parent.closest('.epo-site-search') ||
								parent.closest('.not-content') ||
								parent.closest('.right-sidebar-panel') ||
								parent.closest('header')
							) {
								return NodeFilter.FILTER_REJECT;
							}
							return NodeFilter.FILTER_ACCEPT;
						},
					}
				);

				const nodesToReplace: Node[] = [];
				let curr: Node | null;
				while ((curr = walker.nextNode())) {
					if (curr.nodeValue && curr.nodeValue.toLowerCase().includes(clean.toLowerCase())) {
						nodesToReplace.push(curr);
					}
				}

				const lowerQuery = clean.toLowerCase();
				const qLen = clean.length;
				const newMatches: HTMLElement[] = [];

				for (const textNode of nodesToReplace) {
					const text = textNode.nodeValue || '';
					const parent = textNode.parentNode;
					if (!parent) continue;

					let index = text.toLowerCase().indexOf(lowerQuery);
					if (index === -1) continue;

					const frag = document.createDocumentFragment();
					let lastIndex = 0;

					while (index !== -1) {
						if (index > lastIndex) {
							frag.appendChild(document.createTextNode(text.substring(lastIndex, index)));
						}
						const mark = document.createElement('mark');
						mark.className = 'epo-doc-highlight';
						mark.textContent = text.substring(index, index + qLen);
						frag.appendChild(mark);
						newMatches.push(mark);

						lastIndex = index + qLen;
						index = text.toLowerCase().indexOf(lowerQuery, lastIndex);
					}

					if (lastIndex < text.length) {
						frag.appendChild(document.createTextNode(text.substring(lastIndex)));
					}

					parent.replaceChild(frag, textNode);
				}

				matches = newMatches;
				if (matches.length > 0) {
					updateActiveMatch(0);
				} else {
					if (searchCount) searchCount.textContent = this.dataset.zeroResults || '0';
					if (searchNav) searchNav.style.display = 'flex';
				}
			};

			// Input events: instant in-page filtering
			if (inpageInput) {
				inpageInput.addEventListener('input', () => {
					clearTimeout(debounceTimer);
					debounceTimer = setTimeout(() => {
						performInpageSearch(inpageInput.value);
					}, 50);
				});

				inpageInput.addEventListener('keydown', (e) => {
					if (e.key === 'Enter') {
						e.preventDefault();
						if (e.shiftKey) {
							updateActiveMatch(currentIndex - 1);
						} else {
							updateActiveMatch(currentIndex + 1);
						}
					} else if (e.key === 'Escape') {
						inpageInput.value = '';
						clearHighlights();
						inpageInput.blur();
					}
				});
			}

			// In-page nav buttons
			if (prevBtn) {
				prevBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					updateActiveMatch(currentIndex - 1);
				});
			}

			if (nextBtn) {
				nextBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					updateActiveMatch(currentIndex + 1);
				});
			}

			if (clearBtn) {
				clearBtn.addEventListener('click', (e) => {
					e.stopPropagation();
					if (inpageInput) inpageInput.value = '';
					clearHighlights();
					inpageInput?.focus();
				});
			}

			// Focus input when clicking anywhere in search box (except the Ctrl+K button)
			if (searchBox) {
				searchBox.addEventListener('click', (e) => {
					if (!modalTrigger.contains(e.target as Node) && !searchNav.contains(e.target as Node)) {
						inpageInput?.focus();
					}
				});
			}

			// --- Global Pagefind Search Modal Engine (Ctrl+K / Modal Trigger) ---
			const onClick = (event: MouseEvent) => {
				const isLink = 'href' in (event.target || {});
				if (
					isLink ||
					(document.body.contains(event.target as Node) &&
						!modalFrame.contains(event.target as Node))
				) {
					closeModal();
				}
			};

			const openModal = (event?: MouseEvent) => {
				event?.stopPropagation();
				dialog.showModal();
				document.body.toggleAttribute('data-search-modal-open', true);
				this.querySelector<HTMLInputElement>('#starlight__search input')?.focus();
				window.addEventListener('click', onClick);
			};

			const closeModal = () => {
				dialog.close();
				document.body.toggleAttribute('data-search-modal-open', false);
				window.removeEventListener('click', onClick);
			};

			modalTrigger.addEventListener('click', (e) => {
				openModal(e);
			});

			closeBtn.addEventListener('click', closeModal);

			dialog.addEventListener('close', () => {
				document.body.toggleAttribute('data-search-modal-open', false);
				window.removeEventListener('click', onClick);
			});

			window.addEventListener('keydown', (e) => {
				if ((e.metaKey === true || e.ctrlKey === true) && e.key.toLowerCase() === 'k') {
					e.preventDefault();
					dialog.open ? closeModal() : openModal();
				}
			});

			let translations = {};
			try {
				translations = JSON.parse(this.dataset.translations || '{}');
			} catch {}

			const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
			const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2');
			const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;

				window.addEventListener('DOMContentLoaded', () => {
					if (import.meta.env.DEV) return;
					const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
					onIdle(async () => {
						// @ts-expect-error — Missing types for @pagefind/default-ui package.
						const { PagefindUI } = await import('@pagefind/default-ui');
						new PagefindUI({
							...pagefindUserConfig,
							element: '#starlight__search',
							baseUrl: import.meta.env.BASE_URL,
							bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
							showImages: false,
							translations,
							showSubResults: true,
							processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
								result.url = formatURL(result.url);
								result.sub_results = result.sub_results.map((sub_result) => {
									sub_result.url = formatURL(sub_result.url);
									return sub_result;
								});
							},
						});
					});
				});
			}
		}
		customElements.define('site-search', SiteSearch);
</script>

<style>
	site-search {
		display: contents;
	}

	/* Search box in header - generous width, text never cut off, centered */
	.epo-search-box {
		display: flex;
		align-items: center;
		position: relative;
		height: 36px;
		width: 380px;
		max-width: 420px;
		/* 顶栏拥挤时（德/俄等长文案语言）允许搜索框收缩，占位文字自带省略号；
		   原先 min-width: 300px 会把收缩下限顶进右侧导航区，盖住前两个导航项 */
		min-width: 0;
		flex-shrink: 1;
		padding: 0 0.5rem 0 0.75rem;
		border: 1px solid var(--sl-color-hairline, #e2e8f0);
		border-radius: 9px;
		background-color: var(--sl-color-gray-6, #f8fafc);
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		box-sizing: border-box;
		cursor: text;
	}

	.epo-search-box:hover {
		border-color: var(--sl-color-gray-4, #94a3b8);
		background-color: var(--sl-color-bg, #ffffff);
	}

	.epo-search-box:focus-within {
		border-color: var(--sl-color-accent, #2563eb);
		background-color: var(--sl-color-bg, #ffffff);
		box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
	}

	:root[data-theme='dark'] .epo-search-box {
		background-color: #111827;
		border-color: #1e293b;
	}

	:root[data-theme='dark'] .epo-search-box:hover {
		border-color: #334155;
		background-color: #161f30;
	}

	:root[data-theme='dark'] .epo-search-box:focus-within {
		background-color: #0b0f19;
		border-color: #3b82f6;
		box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
	}

	.search-box-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--sl-color-gray-3, #94a3b8);
		flex-shrink: 0;
		margin-right: 0.25rem;
		transition: color 0.2s ease;
	}

	.epo-search-box:focus-within .search-box-icon {
		color: var(--sl-color-accent, #2563eb);
	}

	:root[data-theme='dark'] .epo-search-box:focus-within .search-box-icon {
		color: #60a5fa;
	}

	.epo-search-input {
		flex: 1 1 auto;
		min-width: 0;
		height: 100%;
		border: none;
		outline: none;
		background: transparent;
		font-size: 0.8125rem;
		color: var(--sl-color-white, #0f172a);
		font-family: var(--sl-font);
		padding: 0 0.35rem;
		letter-spacing: 0.01em;
	}

	.epo-search-input::placeholder {
		color: var(--sl-color-gray-3, #64748b);
		font-size: 0.8125rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	:root[data-theme='dark'] .epo-search-input {
		color: #f8fafc;
	}

	:root[data-theme='dark'] .epo-search-input::placeholder {
		color: #94a3b8;
	}

	/* In-page match controls */
	.epo-search-nav {
		display: flex;
		align-items: center;
		gap: 3px;
		padding-right: 4px;
		flex-shrink: 0;
	}

	.epo-search-count {
		font-size: 0.72rem;
		font-family: var(--sl-font-mono, monospace);
		color: var(--sl-color-accent, #2563eb);
		font-weight: 600;
		padding: 1px 5px;
		background: var(--sl-color-accent-low, rgba(37, 99, 235, 0.08));
		border-radius: 4px;
		white-space: nowrap;
	}

	:root[data-theme='dark'] .epo-search-count {
		color: #60a5fa;
		background: rgba(59, 130, 246, 0.15);
	}

	.inpage-nav-btn,
	.inpage-clear-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border-radius: 4px;
		border: none;
		background: transparent;
		color: var(--sl-color-gray-3, #64748b);
		cursor: pointer;
		padding: 0;
		transition: all 0.15s ease;
	}

	.inpage-nav-btn:hover,
	.inpage-clear-btn:hover {
		color: var(--sl-color-white, #0f172a);
		background-color: var(--sl-color-gray-5, #e2e8f0);
	}

	:root[data-theme='dark'] .inpage-nav-btn:hover,
	:root[data-theme='dark'] .inpage-clear-btn:hover {
		color: #f8fafc;
		background-color: #1e293b;
	}

	/* Shortcut pill for triggering global modal search */
	.search-shortcut-badge {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		padding: 2px 4px;
		border: 1px solid var(--sl-color-hairline, #e2e8f0);
		border-radius: 5px;
		background-color: var(--sl-color-bg, #ffffff);
		color: var(--sl-color-gray-4, #94a3b8);
		cursor: pointer;
		transition: all 0.18s ease;
		flex-shrink: 0;
		margin-left: 0.25rem;
		user-select: none;
	}

	:root[data-theme='dark'] .search-shortcut-badge {
		background-color: #0b0f19;
		border-color: #334155;
	}

	.search-shortcut-badge:hover {
		border-color: var(--sl-color-accent, #2563eb);
		color: var(--sl-color-accent, #2563eb);
		background-color: var(--sl-color-accent-low, rgba(37, 99, 235, 0.08));
	}

	:root[data-theme='dark'] .search-shortcut-badge:hover {
		border-color: #3b82f6;
		color: #60a5fa;
		background-color: rgba(59, 130, 246, 0.15);
	}

	.search-shortcut-badge kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 14px;
		height: 16px;
		font-size: 10px;
		font-family: var(--sl-font-mono, monospace);
		font-weight: 600;
	}

	/* Search Modal Dialog */
	.epo-search-dialog {
		margin: 0;
		border: none;
		background: transparent;
		width: 100%;
		max-width: 100%;
		height: 100%;
		max-height: 100%;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 1rem;
		box-sizing: border-box;
		z-index: 999;
	}

	.epo-search-dialog[open] {
		display: flex;
	}

	.epo-search-dialog::backdrop {
		background-color: rgba(15, 23, 42, 0.65);
