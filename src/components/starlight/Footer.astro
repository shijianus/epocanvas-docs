---
import Pagination from 'virtual:starlight/components/Pagination';
import { getLangFromLocale, getTranslation } from '../../utils/i18n';

const { entry, editUrl } = Astro.locals.starlightRoute;
const lang = getLangFromLocale(Astro.currentLocale);
const title = entry.data.title;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const issue = new URL('https://github.com/shijianus/epocanvas-docs/issues/new');
issue.searchParams.set('title', `[Docs] ${title}`);
issue.searchParams.set('body', `页面 / Page: ${pageUrl.href}\n\n问题描述 / What is wrong:\n`);
---

<footer class="page-footer print:hidden">
	<div class="page-footer-actions">
		<span class="feedback-label" data-i18n="page.feedback">{getTranslation('page.feedback', lang)}</span>
		{
			editUrl && (
				<a href={editUrl.href} target="_blank" rel="noopener noreferrer">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 20h9" />
						<path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
					</svg>
					{Astro.locals.t('page.editLink')}
				</a>
			)
		}
		<a href={issue.href} target="_blank" rel="noopener noreferrer" data-report-issue>
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
				<line x1="4" y1="22" x2="4" y2="15" />
			</svg>
			<span data-i18n="page.reportIssue">{getTranslation('page.reportIssue', lang)}</span>
		</a>
		<a class="back-to-top" href="#_top">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m18 15-6-6-6 6" />
			</svg>
			<span data-i18n="page.backToTop">{getTranslation('page.backToTop', lang)}</span>
		</a>
	</div>
	<Pagination />
</footer>

<style>
	.page-footer {
		display: flex;
		flex-direction: column;
		margin-top: 2.5rem;
	}

	.page-footer-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 1.25rem;
		padding-bottom: 0.9rem;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-3);
	}

	.feedback-label {
		margin-inline-end: auto;
	}

	.page-footer-actions a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		border-radius: 3px;
	}

	.page-footer-actions a:hover {
		color: var(--sl-color-accent);
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}

	.page-footer-actions a:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.back-to-top {
		margin-inline-start: auto;
	}

	@media (max-width: 36rem) {
		.feedback-label {
			flex-basis: 100%;
		}

		.back-to-top {
			margin-inline-start: 0;
		}
	}
</style>
