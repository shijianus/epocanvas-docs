---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const pathname = Astro.url.pathname;
const isMail = pathname.startsWith('/mail');
const isChat = pathname.startsWith('/chat');
const isEccp = pathname.startsWith('/eccp');

const navIconButtons = [
	{
		id: 'mail',
		href: '/mail/',
		active: isMail,
		tooltip: 'EpoMail 邮件服务',
		svg: `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
	},
	{
		id: 'chat',
		href: '/chat/',
		active: isChat,
		tooltip: 'EpoCanvas (Chat) 即时通讯',
		svg: `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>`,
	},
	{
		id: 'eccp',
		href: '/eccp/',
		active: isEccp,
		tooltip: 'ECCP 密码学协议规范',
		svg: `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
	},
];
---

<div class="header sl-flex">
	<div class="header-left sl-flex">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>
	</div>

	<div class="header-center sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="header-right sl-flex print:hidden">
		<!-- Desktop Section Navigation as Icon Buttons with Tooltip Comments -->
		<nav class="nav-icon-group sl-hidden md:sl-flex" aria-label="文档专案快速导航">
			{navIconButtons.map((item) => (
				<a
					href={item.href}
					class:list={['nav-icon-button', { 'is-active': item.active }]}
					aria-current={item.active ? 'page' : undefined}
					data-tooltip={item.tooltip}
					title={item.tooltip}
					aria-label={item.tooltip}
				>
					<Fragment set:html={item.svg} />
				</a>
			))}
		</nav>

		<div class="action-divider sl-hidden md:sl-block"></div>

		<div class="sl-flex items-center gap-2">
			<div class="sl-hidden sm:sl-flex social-icons" title="GitHub 仓库" data-tooltip="GitHub 仓库">
				<SocialIcons />
			</div>
			<div class="theme-select-wrapper" title="切换色彩主题" data-tooltip="切换色彩主题">
				<ThemeSelect />
			</div>
			<LanguageSelect />
		</div>
	</div>
</div>

<style>
	.header {
		gap: 1.25rem;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		width: 100%;
		padding: 0 1rem;
	}

	.header-left {
		align-items: center;
		gap: 1rem;
		min-width: 0;
		flex-shrink: 0;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem 0;
		min-width: 0;
	}

	.header-center {
		flex: 1;
		max-width: 28rem;
		margin: 0 auto;
	}

	.header-right {
		align-items: center;
		gap: 1rem;
		flex-shrink: 0;
	}

	/* Dignified, minimal Icon Button Group */
	.nav-icon-group {
		align-items: center;
		gap: 0.4rem;
	}

	.nav-icon-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 8px;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		border: 1px solid transparent;
		background: transparent;
		transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-icon-button:hover {
		color: var(--sl-color-white);
		background-color: var(--sl-color-gray-6);
		border-color: var(--sl-color-hairline);
		transform: translateY(-1px);
	}

	.nav-icon-button.is-active {
		color: var(--sl-color-accent);
		background-color: var(--sl-color-accent-low);
		border-color: rgba(37, 99, 235, 0.25);
	}

	:root[data-theme='dark'] .nav-icon-button.is-active {
		border-color: rgba(59, 130, 246, 0.35);
	}

	/* Tooltip (shijianus-blog standard: floating pill with micro-transition) */
	.nav-icon-button::after {
		position: absolute;
		top: calc(100% + 9px);
		left: 50%;
		z-index: 100;
		min-width: max-content;
		padding: 5px 9px;
		border-radius: 6px;
		background: #0f172a;
		color: #ffffff;
		content: attr(data-tooltip);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0.02em;
		opacity: 0;
		pointer-events: none;
		transform: translate(-50%, -4px);
		transition: opacity 0.18s ease, transform 0.18s ease;
		white-space: nowrap;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	:root[data-theme='dark'] .nav-icon-button::after {
		background: #1e293b;
		color: #f8fafc;
		border-color: #334155;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
	}

	.nav-icon-button:hover::after {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.action-divider {
		width: 1px;
		height: 1.25rem;
		background: var(--sl-color-hairline, #e2e8f0);
	}

	.social-icons,
	.theme-select-wrapper {
		display: inline-flex;
		align-items: center;
		position: relative;
	}

	@media (min-width: 50rem) {
		.header {
			padding: 0 1.5rem;
		}
	}
</style>
