---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const pathname = Astro.url.pathname;
const isMail = pathname.startsWith('/mail');
const isChat = pathname.startsWith('/chat');
const isEccp = pathname.startsWith('/eccp');

const navItems = [
	{ label: 'EpoMail', href: '/mail/', active: isMail },
	{ label: 'EpoCanvas (Chat)', href: '/chat/', active: isChat },
	{ label: 'ECCP 协议', href: '/eccp/', active: isEccp },
];
---

<div class="header sl-flex">
	<div class="header-left sl-flex">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>
	</div>

	<div class="header-center sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="header-right sl-flex print:hidden">
		<!-- Desktop Section Navigation Links -->
		<nav class="nav-links sl-hidden md:sl-flex" aria-label="文档分区导航">
			{navItems.map((item) => (
				<a
					href={item.href}
					class:list={['nav-link', { 'is-active': item.active }]}
					aria-current={item.active ? 'page' : undefined}
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="action-divider sl-hidden md:sl-block"></div>

		<div class="sl-flex items-center gap-3">
			<div class="sl-hidden sm:sl-flex social-icons">
				<SocialIcons />
			</div>
			<ThemeSelect />
			<LanguageSelect />
		</div>
	</div>
</div>

<style>
	.header {
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		width: 100%;
		padding: 0 1rem;
	}

	.header-left {
		align-items: center;
		gap: 1rem;
		min-width: 0;
		flex-shrink: 0;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem 0;
		min-width: 0;
	}

	.header-center {
		flex: 1;
		max-width: 28rem;
		margin: 0 auto;
	}

	.header-right {
		align-items: center;
		gap: 1.25rem;
		flex-shrink: 0;
	}

	/* Clean, elegant navigation links */
	.nav-links {
		align-items: center;
		gap: 1.25rem;
	}

	.nav-link {
		color: var(--sl-color-gray-2);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		padding: 0.35rem 0.15rem;
		border-bottom: 2px solid transparent;
		transition: color 0.15s ease, border-color 0.15s ease;
		white-space: nowrap;
	}

	.nav-link:hover {
		color: var(--sl-color-white);
	}

	.nav-link.is-active {
		color: var(--sl-color-accent);
		font-weight: 600;
		border-bottom-color: var(--sl-color-accent);
	}

	.action-divider {
		width: 1px;
		height: 1.25rem;
		background: var(--sl-color-hairline, #e2e8f0);
	}

	.social-icons {
		align-items: center;
	}

	@media (min-width: 50rem) {
		.header {
			padding: 0 1.5rem;
		}
	}
</style>
