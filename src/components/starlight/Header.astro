---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const pathname = Astro.url.pathname;
const isChat = pathname.startsWith('/chat');
const isMail = pathname.startsWith('/mail');
const isEccp = pathname.startsWith('/eccp');
const isPortal = !isChat && !isMail && !isEccp;

const projects = [
	{ id: 'portal', label: 'Portal', href: '/', active: isPortal, icon: '🌐' },
	{ id: 'chat', label: 'Chat', badge: 'E2EE', href: '/chat/', active: isChat, icon: '💬' },
	{ id: 'mail', label: 'Mail', badge: 'PGP', href: '/mail/', active: isMail, icon: '✉️' },
	{ id: 'eccp', label: 'ECCP', badge: 'RFC', href: '/eccp/', active: isEccp, icon: '📜' },
];
---

<div class="header sl-flex">
	<div class="header-left sl-flex">
		<div class="title-wrapper sl-flex">
			<SiteTitle />
		</div>

		<!-- Multi-Project Switcher Tabs -->
		<nav class="project-tabs sl-flex" aria-label="EpoCanvas Multi-Project Switcher">
			{projects.map((proj) => (
				<a
					href={proj.href}
					class:list={['project-tab', { 'is-active': proj.active }]}
					aria-current={proj.active ? 'page' : undefined}
				>
					<span class="tab-icon">{proj.icon}</span>
					<span class="tab-label">{proj.label}</span>
					{proj.badge && <span class:list={['tab-badge', `badge-${proj.id}`]}>{proj.badge}</span>}
				</a>
			))}
		</nav>
	</div>

	<div class="header-center sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>

	<div class="header-right sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	.header {
		gap: var(--sl-nav-gap, 1rem);
		justify-content: space-between;
		align-items: center;
		height: 100%;
		width: 100%;
	}

	.header-left {
		align-items: center;
		gap: 1.25rem;
		min-width: 0;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
		flex-shrink: 0;
	}

	/* Project Switcher Tabs */
	.project-tabs {
		display: none;
		align-items: center;
		gap: 0.35rem;
		background: var(--sl-color-gray-6);
		padding: 0.25rem 0.35rem;
		border-radius: var(--ep-radius-md, 8px);
		border: 1px solid var(--sl-color-gray-5);
	}

	@media (min-width: 58rem) {
		.project-tabs {
			display: flex;
		}
	}

	.project-tab {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.25rem 0.65rem;
		border-radius: var(--ep-radius-sm, 6px);
		font-size: 0.82rem;
		font-weight: 500;
		text-decoration: none;
		color: var(--sl-color-gray-2);
		transition: all 0.15s ease-in-out;
		white-space: nowrap;
	}

	.project-tab:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-5);
	}

	.project-tab.is-active {
		color: #ffffff;
		background: var(--ep-theme-main, #425aef);
		font-weight: 600;
		box-shadow: 0 2px 6px rgba(66, 90, 239, 0.3);
	}

	.tab-icon {
		font-size: 0.95rem;
		line-height: 1;
	}

	.tab-badge {
		font-size: 0.65rem;
		font-weight: 700;
		padding: 0.08rem 0.35rem;
		border-radius: 4px;
		letter-spacing: 0.02em;
	}

	.project-tab.is-active .tab-badge {
		background: rgba(255, 255, 255, 0.25);
		color: #ffffff;
		border: none;
	}

	.header-center {
		flex: 1;
		max-width: 32rem;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}

	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
					100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
						(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
						var(--sl-content-width)
				) / 2
			);
			display: grid;
			grid-template-columns: auto 1fr auto;
			align-content: center;
		}
	}
</style>
