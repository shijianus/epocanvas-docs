---
export interface TocItem {
	depth: number;
	text: string;
	slug: string;
	children: TocItem[];
}

interface Props {
	toc: TocItem[];
	depth?: number;
	isMobile?: boolean;
}

const { toc, isMobile = false, depth = 0 } = Astro.props;
---

<ul class:list={{ isMobile }}>
	{
		toc.map((heading) => (
			<li>
				<a href={'#' + heading.slug} class="toc-link">
					<span class="toc-text">{heading.text}</span>
				</a>
				{heading.children.length > 0 && (
					<Astro.self toc={heading.children} depth={depth + 1} isMobile={isMobile} />
				)}
			</li>
		))
	}
</ul>

<style define:vars={{ depth }}>
	ul {
		padding: 0;
		list-style: none;
	}
	li {
		margin: 0.2rem 0;
	}
	a {
		--pad-inline: 0.5rem;
		display: block;
		padding-block: 0.25rem;
		padding-inline: calc(0.75rem * var(--depth) + var(--pad-inline)) var(--pad-inline);
		line-height: 1.4;
		font-size: 0.8125rem;
		color: var(--sl-color-gray-3);
		text-decoration: none;
		transition: color 0.15s ease, border-color 0.15s ease;
		border-inline-start: 2px solid transparent;
	}
	a:hover {
		color: var(--sl-color-white);
	}
	a[aria-current='true'] {
		color: var(--sl-color-accent);
		font-weight: 500;
		border-inline-start-color: var(--sl-color-accent);
		background-color: transparent;
	}
	.isMobile a {
		--pad-inline: 1rem;
		display: flex;
		justify-content: space-between;
		gap: var(--pad-inline);
		border-top: 1px solid var(--sl-color-hairline, #e2e8f0);
		border-radius: 0;
		padding-block: 0.5rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.isMobile:first-child > li:first-child > a {
		border-top: 0;
	}
	.isMobile a[aria-current='true'],
	.isMobile a[aria-current='true']:hover,
	.isMobile a[aria-current='true']:focus {
		color: var(--sl-color-white);
		background-color: unset;
	}
	.isMobile a[aria-current='true']::after {
		content: '';
		width: 1rem;
		background-color: var(--sl-color-accent);
		-webkit-mask-image: url('data:image/svg+xml;base64,');
		mask-image: url('data:image/svg+xml;base64,');
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		flex-shrink: 0;
	}
</style>
